<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <!-- Mobile responsiveness -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="ShopEase - Responsive E-Commerce Website">

    <title>ShopEase - E-Commerce Website</title>

    <style>

        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #222;
            line-height: 1.5;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }


        /* =========================
           HEADER
        ========================= */

        header {
            background: #0f172a;
            color: white;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .top-header {
            min-height: 70px;
            padding: 12px 6%;

            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
            color: #38bdf8;
            white-space: nowrap;
        }

        .search-box {
            flex: 1;
            display: flex;
            max-width: 650px;
            margin: auto;
        }

        .search-box input {
            width: 100%;
            padding: 12px;
            border: none;
            outline: none;
        }

        .search-box button {
            padding: 0 20px;
            border: none;
            background: #2563eb;
            color: white;
        }

        .header-actions {
            display: flex;
            gap: 18px;
            align-items: center;
        }

        .header-actions button {
            background: none;
            border: none;
            color: white;
            font-size: 15px;
        }

        .cart {
            position: relative;
        }

        .cart-count {
            position: absolute;
            top: -12px;
            right: -10px;

            background: #ef4444;
            color: white;

            width: 20px;
            height: 20px;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 12px;
        }


        /* =========================
           NAVIGATION
        ========================= */

        .navigation {
            background: white;
            color: #222;

            display: flex;
            justify-content: center;

            gap: 35px;

            padding: 14px;
        }

        .navigation a {
            text-decoration: none;
            color: #222;
            font-weight: bold;
        }

        .navigation a:hover {
            color: #2563eb;
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            margin: 25px 6%;

            min-height: 360px;

            border-radius: 15px;

            background: linear-gradient(
                120deg,
                #dbeafe,
                #eff6ff
            );

            display: flex;
            align-items: center;

            padding: 50px;
        }

        .hero-content {
            max-width: 600px;
        }

        .hero h1 {
            font-size: clamp(35px, 5vw, 60px);
            margin-bottom: 15px;
        }

        .hero h1 span {
            color: #2563eb;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .shop-button {
            border: none;
            padding: 13px 28px;

            background: #2563eb;
            color: white;

            border-radius: 6px;
        }

        .shop-button:hover {
            background: #1d4ed8;
        }


        /* =========================
           SECTIONS
        ========================= */

        .section {
            padding: 45px 6%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 30px;
            font-size: 32px;
        }


        /* =========================
           CATEGORIES
        ========================= */

        .categories {
            display: grid;

            grid-template-columns:
                repeat(5, 1fr);

            gap: 15px;
        }

        .category {
            background: white;

            padding: 25px 10px;

            text-align: center;

            border-radius: 10px;

            box-shadow:
                0 3px 10px rgba(0,0,0,0.08);

            cursor: pointer;

            transition: 0.3s;
        }

        .category:hover {
            transform: translateY(-5px);
        }

        .category-icon {
            font-size: 35px;
            margin-bottom: 10px;
        }


        /* =========================
           FILTERS
        ========================= */

        .filters {
            display: flex;
            justify-content: center;
            gap: 15px;

            margin-bottom: 30px;

            flex-wrap: wrap;
        }

        .filters select {
            padding: 10px 15px;

            border: 1px solid #ccc;

            border-radius: 6px;

            background: white;
        }


        /* =========================
           PRODUCTS
        ========================= */

        .products {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;
        }

        .product {
            background: white;

            border-radius: 10px;

            overflow: hidden;

            box-shadow:
                0 3px 12px rgba(0,0,0,0.08);

            transition: 0.3s;
        }

        .product:hover {
            transform: translateY(-5px);
        }

        .product-image {
            width: 100%;
            height: 200px;

            object-fit: contain;

            padding: 15px;
        }

        .product-info {
            padding: 18px;
        }

        .product h3 {
            margin-bottom: 8px;
        }

        .category-name {
            color: #64748b;
            font-size: 13px;
        }

        .rating {
            color: #f59e0b;
            margin: 8px 0;
        }

        .price {
            font-size: 20px;
            font-weight: bold;
        }

        .old-price {
            color: #888;
            text-decoration: line-through;
            font-size: 14px;
            margin-left: 5px;
        }

        .add-cart {
            width: 100%;

            margin-top: 12px;

            padding: 10px;

            border: none;

            border-radius: 5px;

            background: #2563eb;
            color: white;
        }

        .add-cart:hover {
            background: #1d4ed8;
        }


        /* =========================
           SERVICES
        ========================= */

        .services {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;

            background: white;

            padding: 25px;

            border-radius: 10px;
        }

        .service {
            text-align: center;
        }

        .service-icon {
            font-size: 30px;
        }

        .service h3 {
            margin: 8px 0;
        }


        /* =========================
           CART PANEL
        ========================= */

        .cart-panel {
            position: fixed;

            top: 0;
            right: -400px;

            width: 350px;
            max-width: 90%;

            height: 100vh;

            background: white;

            z-index: 2000;

            padding: 25px;

            box-shadow:
                -5px 0 20px rgba(0,0,0,0.2);

            transition: right 0.3s;

            overflow-y: auto;
        }

        .cart-panel.open {
            right: 0;
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .close-cart {
            border: none;
            background: none;
            font-size: 25px;
        }

        .cart-item {
            border-bottom: 1px solid #ddd;

            padding: 12px 0;

            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .remove-item {
            border: none;
            background: #ef4444;
            color: white;

            padding: 5px 8px;

            border-radius: 4px;
        }

        .cart-total {
            margin-top: 20px;

            font-size: 20px;

            font-weight: bold;
        }


        /* =========================
           CONTACT
        ========================= */

        .contact {
            max-width: 650px;
            margin: auto;
        }

        .contact form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .contact input,
        .contact textarea {
            padding: 12px;

            border: 1px solid #ccc;

            border-radius: 6px;
        }

        .contact textarea {
            min-height: 120px;
        }

        .contact button {
            padding: 12px;

            border: none;

            border-radius: 6px;

            background: #2563eb;
            color: white;
        }

        #contactMessage {
            text-align: center;
            font-weight: bold;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #0f172a;
            color: white;

            text-align: center;

            padding: 25px;

            margin-top: 30px;
        }


        /* =========================
           DARK MODE
        ========================= */

        body.dark {
            background: #111827;
            color: white;
        }

        body.dark .navigation {
            background: #1f2937;
        }

        body.dark .navigation a {
            color: white;
        }

        body.dark .category,
        body.dark .product,
        body.dark .services,
        body.dark .filters select,
        body.dark .cart-panel {
            background: #1f2937;
            color: white;
        }

        body.dark .contact input,
        body.dark .contact textarea {
            background: #1f2937;
            color: white;
            border-color: #555;
        }

        body.dark .hero {
            background: #1e3a5f;
        }


        /* =========================
           MOBILE RESPONSIVE
        ========================= */

        @media (max-width: 1000px) {

            .products {
                grid-template-columns:
                    repeat(3, 1fr);
            }

            .categories {
                grid-template-columns:
                    repeat(3, 1fr);
            }

            .services {
                grid-template-columns:
                    repeat(2, 1fr);
            }
        }


        @media (max-width: 700px) {

            .top-header {
                flex-wrap: wrap;
            }

            .search-box {
                order: 3;
                flex-basis: 100%;
            }

            .navigation {
                gap: 15px;
                overflow-x: auto;
                justify-content: flex-start;
            }

            .hero {
                padding: 30px 20px;
                min-height: 300px;
            }

            .hero h1 {
                font-size: 38px;
            }

            .products {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .categories {
                grid-template-columns:
                    repeat(2, 1fr);
            }
        }


        @media (max-width: 450px) {

            .products {
                grid-template-columns: 1fr;
            }

            .categories {
                grid-template-columns: 1fr;
            }

            .services {
                grid-template-columns: 1fr;
            }

            .header-actions {
                gap: 8px;
            }

            .logo {
                font-size: 21px;
            }
        }

    </style>

</head>


<body>


